// Nix provides defaults; popup edits are saved in Brave's persistent profile.
const nixHosts = @WARP_HOSTS@;

function normalizeHost(input) {
  if (typeof input !== "string" || !input.trim()) throw new Error("Enter a site address");
  const value = input.trim();
  let url;
  try {
    url = new URL(value.includes("://") ? value : `https://${value}`);
  } catch {
    throw new Error("Enter a valid hostname or HTTP(S) URL");
  }
  if (!["http:", "https:"].includes(url.protocol) || url.username || url.password) {
    throw new Error("Use a hostname or HTTP(S) URL without credentials");
  }
  const host = url.hostname.toLowerCase().replace(/\.$/, "");
  const labels = host.split(".");
  if (labels.length < 2 || host.length > 253 || labels.some(
    (label) => label.length < 1 || label.length > 63 || !/^[a-z0-9](?:[a-z0-9-]*[a-z0-9])?$/.test(label)
  )) {
    throw new Error("Enter a valid DNS hostname, such as search.nixos.org");
  }
  return host;
}

function effectiveHosts({ addedHosts, removedHosts }) {
  const removed = new Set(removedHosts);
  return [...new Set([...nixHosts.filter((host) => !removed.has(host)), ...addedHosts])];
}

async function savedState() {
  return chrome.storage.local.get({
    enabled: true,
    addedHosts: [],
    removedHosts: [],
    proxyError: null,
    proxyErrorAt: null,
  });
}

function pacFor(hosts) {
  return `
function FindProxyForURL(url, host) {
  var proxyHosts = ${JSON.stringify(hosts)};
  if (proxyHosts.indexOf(host.toLowerCase().replace(/\\.$/, "")) !== -1) {
    return "SOCKS5 127.0.0.1:40000";
  }
  return "DIRECT";
}
`;
}

function proxySetting(method, details) {
  return new Promise((resolve, reject) => {
    chrome.proxy.settings[method](details, (result) => {
      const error = chrome.runtime.lastError;
      if (error) reject(new Error(error.message));
      else resolve(result);
    });
  });
}

async function applyProxy(state) {
  if (state.enabled) {
    await proxySetting("set", {
      value: { mode: "pac_script", pacScript: { data: pacFor(effectiveHosts(state)), mandatory: true } },
      scope: "regular",
    });
  } else {
    await proxySetting("clear", { scope: "regular" });
  }
}

async function currentState() {
  const saved = await savedState();
  const setting = await proxySetting("get", { incognito: false });
  return {
    ...saved,
    apiVersion: 2,
    extensionVersion: chrome.runtime.getManifest().version,
    hosts: effectiveHosts(saved),
    nixHosts,
    levelOfControl: setting.levelOfControl,
  };
}

async function restoreProxy() {
  await applyProxy(await savedState());
}

let changeQueue = Promise.resolve();
function changeHosts(type, input) {
  const change = changeQueue.then(async () => {
    const state = await savedState();
    if (type === "resetHosts") {
      state.addedHosts = [];
      state.removedHosts = [];
    } else {
      const host = normalizeHost(input);
      const added = new Set(state.addedHosts);
      const removed = new Set(state.removedHosts);
      if (type === "addHost") {
        removed.delete(host);
        if (!nixHosts.includes(host)) added.add(host);
      } else if (type === "removeHost") {
        added.delete(host);
        if (nixHosts.includes(host)) removed.add(host);
      }
      state.addedHosts = [...added];
      state.removedHosts = [...removed];
    }
    await chrome.storage.local.set({ addedHosts: state.addedHosts, removedHosts: state.removedHosts });
    await applyProxy(state);
    return currentState();
  });
  changeQueue = change.catch(() => {});
  return change;
}

chrome.runtime.onInstalled.addListener(() => { void restoreProxy(); });
chrome.runtime.onStartup.addListener(() => { void restoreProxy(); });
chrome.proxy.onProxyError.addListener(({ error }) => {
  void chrome.storage.local.set({ proxyError: error, proxyErrorAt: Date.now() });
});

chrome.runtime.onMessage.addListener((message, _sender, sendResponse) => {
  const task = (async () => {
    if (message.type === "state") return currentState();
    if (message.type === "setEnabled") {
      const enabled = message.enabled === true;
      await chrome.storage.local.set({ enabled, proxyError: null, proxyErrorAt: null });
      await restoreProxy();
      return currentState();
    }
    if (message.type === "retry") {
      await chrome.storage.local.set({ proxyError: null, proxyErrorAt: null });
      await restoreProxy();
      return currentState();
    }
    if (["addHost", "removeHost", "resetHosts"].includes(message.type)) {
      return changeHosts(message.type, message.host);
    }
    throw new Error("Unknown extension request");
  })();

  task.then(sendResponse, (error) => sendResponse({ error: error.message }));
  return true;
});

void restoreProxy();
