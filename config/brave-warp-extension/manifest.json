{
  "manifest_version": 3,
  "name": "WARP for selected sites",
  "version": "1.3.0",
  "description": "Routes selected sites through the local Cloudflare WARP proxy.",
  "permissions": ["proxy", "storage", "activeTab"],
  "icons": {
    "16": "icon-16.png",
    "32": "icon-32.png",
    "48": "icon-48.png",
    "128": "icon-128.png"
  },
  "action": {
    "default_title": "WARP for selected sites",
    "default_popup": "popup.html",
    "default_icon": "icon-32.png"
  },
  "background": {
    "service_worker": "background.js"
  }
}
