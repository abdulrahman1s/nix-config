#!/usr/bin/env just --justfile

default:
    @just --list --justfile ~/system-conf/config/justfile

# Reboot into BIOS/UEFI
bios:
    systemctl reboot --firmware-setup

# Shut down the system
shutdown:
    systemctl poweroff

# Verify store integrity
verify-store:
    nix-store --verify --check-contents


# Show free btrfs storage on /
free:
   @just storage

# Show free btrfs storage on /
storage:
    #!/usr/bin/env bash
    set -euo pipefail

    mount=/
    usage=$(btrfs fi usage --raw "$mount" 2>/dev/null)

    size=$(awk '/Device size:/{print $3; exit}' <<<"$usage")
    unalloc=$(awk '/Device unallocated:/{print $3; exit}' <<<"$usage")
    used=$(awk '$1 == "Used:" { print $2; exit }' <<<"$usage")
    free_est=$(awk '/Free \(estimated\):/{print $3; exit}' <<<"$usage")
    df_free=$(awk '/Free \(statfs, df\):/{print $4; exit}' <<<"$usage")

    if [[ -z "$size" || -z "$unalloc" || -z "$used" || -z "$free_est" || -z "$df_free" ]]; then
        echo "Could not parse btrfs usage for $mount" >&2
        exit 1
    fi

    if [ -t 1 ] && command -v tput >/dev/null; then
        bold=$(tput bold 2>/dev/null || true)
        dim=$(tput dim 2>/dev/null || true)
        red=$(tput setaf 1 2>/dev/null || true)
        green=$(tput setaf 2 2>/dev/null || true)
        yellow=$(tput setaf 3 2>/dev/null || true)
        blue=$(tput setaf 4 2>/dev/null || true)
        reset=$(tput sgr0 2>/dev/null || true)
    else
        bold=
        dim=
        red=
        green=
        yellow=
        blue=
        reset=
    fi

    gb() {
        awk -v bytes="$1" 'BEGIN { printf "%.1f GB", bytes / 1000 / 1000 / 1000 }'
    }

    bar() {
        awk -v pct="$1" -v good="$2" -v warn="$3" -v bad="$4" -v reset="$5" 'BEGIN {
            width = 24
            filled = int((pct * width / 100) + 0.5)
            color = pct >= 90 ? bad : pct >= 75 ? warn : good
            printf "["
            for (i = 1; i <= width; i++) {
                if (i == 1) {
                    printf color
                }
                printf i <= filled ? "#" : "-"
            }
            printf reset "]"
        }'
    }

    reclaimable=$((free_est - unalloc))
    if [ "$reclaimable" -lt 0 ]; then
        reclaimable=0
    fi

    used_pct=$(((used * 100 + size / 2) / size))
    used_color=$green
    if [ "$used_pct" -ge 90 ]; then
        used_color=$red
    elif [ "$used_pct" -ge 75 ]; then
        used_color=$yellow
    fi

    printf '\n%sBtrfs storage:%s %s\n' "$bold" "$reset" "$mount"
    printf '%s %s%d%%%s used\n\n' "$(bar "$used_pct" "$green" "$yellow" "$red" "$reset")" "$used_color" "$used_pct" "$reset"
    printf '  %s%-14s%s %12s\n' "$green" "Free" "$reset" "$(gb "$free_est")"
    printf '  %s%-14s%s %12s\n' "$dim" "DF/statfs" "$reset" "$(gb "$df_free")"
    printf '  %s%-14s%s %12s\n' "$blue" "Unallocated" "$reset" "$(gb "$unalloc")"
    printf '  %s%-14s%s %12s\n' "$yellow" "Reclaimable" "$reset" "$(gb "$reclaimable")"
    printf '  %s%-14s%s %12s / %s\n' "$used_color" "Used" "$reset" "$(gb "$used")" "$(gb "$size")"

# Re-link dotfiles into ~/.config/ without a full rebuild
link:
    nix eval --raw "$HOME/system-conf#nixosConfigurations.default.config.system.userActivationScripts.script" | bash

logs:
    @just --justfile ~/system-conf/config/justfile --list | grep logs-

# Show all messages from this boot
logs-this-boot:
    journalctl -b 0 --no-hostname

# Show all messages from last boot
logs-last-boot:
    journalctl -b -1 --no-hostname

# Garbage Collect (Free space)
clean:
    #!/usr/bin/env bash
    set -euo pipefail

    bytes_free() {
        df --output=avail -B1 / | awk 'NR == 2 { print $1 }'
    }

    separator() {
        printf '%*s\n' 72 '' | tr ' ' '-'
    }

    format_bytes() {
        local bytes="$1"
        awk -v bytes="$bytes" 'BEGIN {
            split("B KB MB GB TB", units)
            value = bytes
            unit = 1
            while (value >= 1000 && unit < 5) {
                value /= 1000
                unit++
            }
            if (unit == 1) {
                printf "%d %s", bytes, units[unit]
            } else {
                printf "%.1f %s", value, units[unit]
            }
        }'
    }

    format_delta() {
        local delta="$1"
        if (( delta >= 0 )); then
            printf '+%s' "$(format_bytes "$delta")"
        else
            printf -- '-%s' "$(format_bytes "$((-delta))")"
        fi
    }

    run_step() {
        local label="$1"
        shift

        local before after delta status
        printf '\n'
        separator
        printf '%s\n' "$label"
        separator

        before=$(bytes_free)
        if "$@"; then
            status=0
        else
            status=$?
        fi
        after=$(bytes_free)
        delta=$((after - before))

        step_names+=("$label")
        step_deltas+=("$delta")
        step_statuses+=("$status")

        if (( delta >= 0 )); then
            printf '\nFreed: %s\n' "$(format_bytes "$delta")"
        else
            printf '\nUsed: %s\n' "$(format_bytes "$((-delta))")"
        fi
        if (( status == 0 )); then
            printf 'Status: ok\n'
        else
            printf 'Status: failed (exit %d)\n' "$status"
        fi
        return "$status"
    }

    clean_coredumps() {
        if [[ -d /var/lib/systemd/coredump ]]; then
            sudo find /var/lib/systemd/coredump -type f -delete
        fi
    }

    print_summary() {
        local final_free total_delta i status status_text
        final_free=$(bytes_free 2>/dev/null || printf '%s' "$initial_free")
        total_delta=$((final_free - initial_free))

        printf '\n'
        separator
        printf 'Cleanup summary\n'
        separator
        printf '%-32s %14s %10s\n' 'Step' 'Change' 'Status'
        printf '%-32s %14s %10s\n' '----' '------' '------'

        for i in "${!step_names[@]}"; do
            status="${step_statuses[$i]}"
            if (( status == 0 )); then
                status_text="ok"
            else
                status_text="failed:$status"
            fi
            printf '%-32s %14s %10s\n' \
                "${step_names[$i]}" \
                "$(format_delta "${step_deltas[$i]}")" \
                "$status_text"
        done

        printf '%-32s %14s\n' 'Total' "$(format_delta "$total_delta")"
    }

    step_names=()
    step_deltas=()
    step_statuses=()

    initial_free=$(bytes_free)
    trap 'status=$?; trap - EXIT; print_summary; exit "$status"' EXIT

    run_step "Nix store cleanup" nh clean all
    run_step "Nix store optimize" nix-store --optimise
    run_step "Podman prune" podman system prune -f
    run_step "Coredump cleanup" clean_coredumps
    run_step "Journal vacuum" sudo journalctl --vacuum-time=7d --vacuum-size=512M
    run_step "Old system generations" sudo nix-collect-garbage -d
    run_step "Btrfs balance" just --justfile "$HOME/system-conf/config/justfile" balance


# Reclaim btrfs allocated-but-unused chunks; stops once `target_pct` of the device is unallocated
balance target_pct="10":
    #!/usr/bin/env bash
    set -euo pipefail

    mount=/
    target_unalloc_pct={{target_pct}}
    min_reclaim=$((2 * 1000 * 1000 * 1000))
    min_step_reclaim=$((500 * 1000 * 1000))
    data_tiers=(10 25 50 75)
    data_limit=15

    # Defer if the kernel is already balancing — running two passes serially makes no progress.
    if btrfs balance status "$mount" 2>/dev/null | grep -q "Balance on .* is running"; then
        echo "⚠️  Balance already running on $mount; deferring"
        btrfs balance status "$mount"
        exit 0
    fi

    parse_section() {
        awk -v lbl="$1" '$0 ~ "^"lbl"," {
            for (i = 1; i <= NF; i++) {
                if ($i ~ /^Size:/) { sub(/^Size:/, "", $i); sub(/,$/, "", $i); s=$i }
                if ($i ~ /^Used:/) { sub(/^Used:/, "", $i); sub(/,$/, "", $i); u=$i }
            }
            print s, u
            exit
        }' <<<"$2"
    }

    gb() {
        awk -v bytes="$1" 'BEGIN { printf "%.1f", bytes / 1000 / 1000 / 1000 }'
    }

    refresh() {
        local u; u=$(btrfs fi usage --raw "$mount" 2>/dev/null)
        device_size=$(awk '/Device size:/{print $3; exit}' <<<"$u")
        unalloc=$(awk '/Device unallocated:/{print $3; exit}' <<<"$u")
        free_est=$(awk '/Free \(estimated\):/{print $3; exit}' <<<"$u")
        read -r data_size data_used <<<"$(parse_section Data "$u")"
        read -r meta_size meta_used <<<"$(parse_section Metadata "$u")"
        reclaimable=$((free_est - unalloc))
        if (( reclaimable < 0 )); then reclaimable=0; fi
    }

    refresh

    if [[ -z "${device_size:-}" || -z "${unalloc:-}" || -z "${data_size:-}" || "${data_size:-0}" -eq 0 ]]; then
        echo "Could not parse btrfs usage for $mount" >&2
        exit 1
    fi

    target_unalloc=$((device_size * target_unalloc_pct / 100))

    printf '📊 %s: %s GB unallocated (target ≥ %s), %s GB reclaimable\n' \
        "$mount" "$(gb "$unalloc")" "$(gb "$target_unalloc")" "$(gb "$reclaimable")"

    if [ "$reclaimable" -lt "$min_reclaim" ]; then
        echo "✓  Only $(gb "$reclaimable") GB reclaimable; balance can't help"
        exit 0
    fi
    if [ "$unalloc" -ge "$target_unalloc" ]; then
        echo "✓  Already at target unallocated; skipping balance"
        exit 0
    fi

    # Tier from cheap (dusage=10, ~MB of I/O) up to expensive (dusage=75, ~GB of I/O)
    # and stop the moment the unallocated target is met. Bails early if a pass freed
    # almost nothing — diminishing returns mean the next tier won't help either.
    for tier in "${data_tiers[@]}"; do
        if [ "$unalloc" -ge "$target_unalloc" ]; then
            echo "✓  Target unallocated reached ($(gb "$unalloc") GB)"
            break
        fi

        before=$unalloc
        echo "⚖️  Data balance: -dusage=$tier,limit=$data_limit"
        sudo btrfs balance start -d"usage=$tier,limit=$data_limit" "$mount" || true
        refresh
        freed=$((unalloc - before))
        printf '   unallocated %s GB (+%s), reclaimable %s GB\n' \
            "$(gb "$unalloc")" "$(gb "$freed")" "$(gb "$reclaimable")"

        if [ "$freed" -lt "$min_step_reclaim" ] && [ "$tier" -ge 25 ]; then
            echo "   diminishing returns; stopping"
            break
        fi
    done

    # Metadata balance is expensive and risks ENOSPC on a tight FS — only touch
    # it when there's a non-trivial pool with real waste (>1 GB allocated, <50% used).
    if [ -n "${meta_size:-}" ] && [ "$meta_size" -gt $((1000 * 1000 * 1000)) ]; then
        meta_pct=$((meta_used * 100 / meta_size))
        if [ "$meta_pct" -lt 50 ]; then
            echo "⚖️  Metadata balance: -musage=50,limit=5 (${meta_pct}% used of $(gb "$meta_size") GB)"
            sudo btrfs balance start -m"usage=50,limit=5" "$mount" || true
            refresh
        fi
    fi

    printf '✅ Done. Unallocated: %s GB / %s GB device\n' "$(gb "$unalloc")" "$(gb "$device_size")"

# Show generation history
history:
    nix profile history --profile /nix/var/nix/profiles/system

# --- Generic Service Control ---

# Start a system service
start service:
    sudo systemctl start {{service}}

# Stop a system service
stop service:
    sudo systemctl stop {{service}}

# Restart the system, or restart a system service when given one
restart service="":
    #!/usr/bin/env bash
    set -euo pipefail

    service="{{service}}"
    if [ -z "$service" ]; then
        systemctl reboot
    else
        sudo systemctl restart "$service"
    fi

# Check service status
status service:
    systemctl status {{service}}

# agenix secrets — `secret <view|edit|add|remove> [name]` (e.g. `os secret view rclone.conf`)
secret action="" name="":
    #!/usr/bin/env bash
    set -euo pipefail

    dir="$HOME/system-conf/secrets"
    rules="$dir/secrets.nix"
    action="{{action}}"
    name="{{name}}"

    # fzf-pick an existing secret name (without the .age suffix)
    pick() { basename -a -s .age "$dir"/*.age | fzf --prompt='secret ❯ ' --height=40% --reverse; }

    case "$action" in
      view)
        [ -n "$name" ] || { name=$(pick) || exit 0; }
        name="${name%.age}"
        if [ ! -f "$dir/$name.age" ]; then
            echo "No secret '$name' in $dir. Available:" >&2
            basename -a -s .age "$dir"/*.age >&2
            exit 1
        fi
        # agenix -d reads RULES from ./secrets.nix and uses the file's basename
        # as the rule key, so run it from inside the secrets dir. Decrypts with
        # ~/.ssh/id_ed25519 (the recipient key in secrets.nix).
        cd "$dir" && agenix -d "$name.age"
        ;;
      edit)
        [ -n "$name" ] || { name=$(pick) || exit 0; }
        name="${name%.age}"
        # agenix re-encrypts to every recipient in secrets.nix on save (no-op
        # if the content is unchanged).
        cd "$dir" && agenix -e "$name.age"
        ;;
      add)
        [ -n "$name" ] || { echo "Usage: secret add <name>" >&2; exit 1; }
        name="${name%.age}"
        age="$name.age"
        if [ -f "$dir/$age" ] || grep -qF "\"$age\".publicKeys" "$rules"; then
            echo "$age already exists — use 'secret edit $name'" >&2
            exit 1
        fi
        # Reuse the recipient list from an existing rule so keys aren't hardcoded.
        recipients=$(grep -oE '\.publicKeys = \[[^]]*\];' "$rules" | head -1 | sed 's/^\.publicKeys = //')
        [ -n "$recipients" ] || { echo "Couldn't read recipients from $rules" >&2; exit 1; }
        # Splice the new rule in just before the attrset's closing brace.
        newrule="  \"$age\".publicKeys = $recipients"
        awk -v rule="$newrule" '
            { lines[NR] = $0 }
            END {
                for (i = NR; i >= 1; i--) if (lines[i] ~ /^}[[:space:]]*$/) { c = i; break }
                if (!c) { print "no closing brace in rules file" > "/dev/stderr"; exit 1 }
                for (i = 1; i <= NR; i++) { if (i == c) print rule; print lines[i] }
            }
        ' "$rules" > "$rules.tmp" && mv "$rules.tmp" "$rules"
        echo "Added rule for $age to secrets.nix"
        # Enter the value; agenix encrypts to the recipients on save.
        cd "$dir"
        if agenix -e "$age"; then
            echo "Created $dir/$age — 'git add' it before rebuild."
        else
            echo "Editor aborted; rule left in secrets.nix (no $age created)." >&2
            exit 1
        fi
        ;;
      remove|rm|delete)
        [ -n "$name" ] || { name=$(pick) || exit 0; }
        name="${name%.age}"
        age="$name.age"
        if [ ! -f "$dir/$age" ] && ! grep -qF "\"$age\".publicKeys" "$rules"; then
            echo "No secret '$name' in $dir" >&2
            exit 1
        fi
        # Warn if it's still wired into the NixOS config — the build breaks if
        # an age.secrets.*.file points at a deleted .age.
        refs=$(grep -rln --include='*.nix' -F "$age" "$HOME/system-conf" | grep -vF "$rules" || true)
        if [ -n "$refs" ]; then
            echo "⚠️  $age is still referenced in:" >&2
            echo "$refs" | sed 's/^/    /' >&2
            echo "   Remove its age.secrets.* wiring there too, or the build will fail." >&2
        fi
        read -r -p "Remove $age (delete file + rule)? [y/N] " reply || true
        [[ "$reply" == [yY]* ]] || { echo "Aborted."; exit 0; }
        if grep -qF "\"$age\".publicKeys" "$rules"; then
            grep -vF "\"$age\".publicKeys" "$rules" > "$rules.tmp" && mv "$rules.tmp" "$rules"
            echo "Removed rule for $age from secrets.nix"
        fi
        if [ -f "$dir/$age" ]; then
            rm -f "$dir/$age"
            echo "Deleted $dir/$age — 'git add -A' to stage the removal."
        fi
        ;;
      ""|-h|--help|help)
        echo "Usage: secret <view|edit|add|remove> [name]" >&2
        echo "  view   [name]   decrypt to stdout      (no name → fzf-pick)" >&2
        echo "  edit   [name]   edit in \$EDITOR        (no name → fzf-pick)" >&2
        echo "  add    <name>   create a new secret    (adds a rule to secrets.nix)" >&2
        echo "  remove [name]   delete file + rule     (no name → fzf-pick; confirms)" >&2
        exit 1
        ;;
      *)
        echo "secret: unknown action '$action' (use view | edit | add | remove)" >&2
        exit 1
        ;;
    esac
