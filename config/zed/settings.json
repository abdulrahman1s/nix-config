{
  "cli_default_open_behavior": "existing_window",
  "base_keymap": "VSCode",
  "auto_install_extensions": {
    "kdl": true,
    "nix": true,
    "vscode-dark-modern": true,
    "vscode-icons": true
  },
  "theme": {
    "mode": "dark",
    "light": "Ayu Light",
    "dark": "VSCode Dark Modern"
  },
  "icon_theme": {
    "mode": "dark",
    "light": "VSCode Icons for Zed (Light)",
    "dark": "VSCode Icons for Zed (Dark)"
  },
  "telemetry": {
    "diagnostics": false,
    "metrics": false
  },
  "edit_predictions": {
    "provider": "none"
  },
  "show_edit_predictions": false,
  "languages": {
    "Nix": {
      "language_servers": ["nixd", "!nil"]
    }
  },
  "lsp": {
    "nixd": {
      "settings": {
        "nixpkgs": {
          "expr": "import (builtins.getFlake (builtins.toString ./.)).inputs.nixpkgs { }"
        },
        "formatting": {
          "command": ["nixpkgs-fmt"]
        },
        "options": {
          "nixos": {
            "expr": "(builtins.getFlake (builtins.toString ./.)).nixosConfigurations.default.options"
          }
        }
      }
    }
  },
  "autosave": "on_focus_change",
  "ui_font_size": 17,
  "buffer_font_family": "JetBrainsMono Nerd Font",
  "buffer_font_size": 15,
  "buffer_line_height": "standard",
  "rounded_selection": false,
  "colorize_brackets": true,
  "tab_bar": {
    "show": true,
    "show_nav_history_buttons": false,
    "show_tab_bar_buttons": true
  },
  "tabs": {
    "close_position": "right",
    "file_icons": true,
    "git_status": true,
    "activate_on_close": "history",
    "show_close_button": "hover",
    "show_diagnostics": "all"
  },
  "toolbar": {
    "breadcrumbs": true,
    "quick_actions": true
  },
  "title_bar": {
    "show_menus": true,
    "show_onboarding_banner": false
  },
  "status_bar": {
    "active_language_button": true,
    "cursor_position_button": true,
    "line_endings_button": true
  },
  "project_panel": {
    "button": true,
    "dock": "left",
    "default_width": 320,
    "entry_spacing": "comfortable",
    "file_icons": true,
    "folder_icons": true,
    "git_status": true,
    "indent_size": 20,
    "auto_fold_dirs": true,
    "sticky_scroll": true
  },
  "git_panel": {
    "button": true,
    "dock": "left",
    "default_width": 360
  },
  "outline_panel": {
    "button": true,
    "dock": "left",
    "default_width": 320,
    "indent_size": 20
  },
  "agent": {
    "default_model": {
      "provider": "openai",
      "model": "gpt-5.6-sol",
      "enable_thinking": true,
      "effort": "low"
    },
    "button": true,
    "dock": "right",
    "default_width": 420
  },
  "agent_servers": {
    "OpenCode": {
      "type": "custom",
      "command": "opencode",
      "args": ["acp"]
    }
  },
  "search": {
    "button": true
  },
  "diagnostics": {
    "button": true,
    "include_warnings": true
  },
  "minimap": {
    "show": "always",
    "thumb": "hover",
    "thumb_border": "left_open"
  },
  "scrollbar": {
    "show": "always"
  },
  "terminal": {
    "dock": "bottom",
    "default_height": 300,
    "font_family": "JetBrainsMono Nerd Font",
    "font_size": 14,
    "line_height": "standard",
    "cursor_shape": "block",
    "toolbar": {
      "breadcrumbs": true
    }
  }
}
